# Frontend environment variables (Next.js — public, must be NEXT_PUBLIC_*)

# Backend root URL including scheme and port (no trailing slash).
# Example: NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# When NEXT_PUBLIC_API_URL is unset OR empty, the app runs in demo mode:
#   - scoreRecording() returns fabricated but plausible AssessmentResult payloads
#   - native-reference playback uses the browser's SpeechSynthesis API where applicable

NEXT_PUBLIC_API_URL=
# Force mock mode even if NEXT_PUBLIC_API_URL is set:
NEXT_PUBLIC_USE_MOCK=
