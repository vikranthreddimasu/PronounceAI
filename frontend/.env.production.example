# Production frontend env vars for Vercel.

# Set this after your Daytona backend is public.
# Example: NEXT_PUBLIC_API_URL=https://your-daytona-backend.example.dev
NEXT_PUBLIC_API_URL=

# Emergency final-demo fallback. Leave blank/0 for the real backend, set to 1
# if the backend is unavailable and you need the polished local mock flow.
NEXT_PUBLIC_USE_MOCK=
