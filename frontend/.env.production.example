# Frontend runtime env vars.

# Set this to the backend root URL when running against the live API.
# Local Docker/compose example: NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=

# Demo fallback. Leave blank/0 for the real backend, set to 1 to force
# local mock scoring and browser speech synthesis.
NEXT_PUBLIC_USE_MOCK=
