# HuggingFace — downloading models + datasets (public models, token optional)
HUGGINGFACE_TOKEN=

# Backend config
DEVICE=mps              # mps (Apple Silicon) | cuda | cpu
LOG_LEVEL=info
PORT=8000
# Comma-separated allowed browser origins for the frontend, e.g. https://app.example.com
# Use * alone to allow any origin (credentials disabled). Empty = localhost:3000 + :3001
# CORS_ORIGINS=

# espeak-ng shared library (Homebrew on macOS)
ESPEAK_NG_LIB=/opt/homebrew/lib/libespeak-ng.dylib

# Model paths (relative to backend/)
WAV2VEC2_MODEL=slplab/wav2vec2-large-robust-L2-english-phoneme-recognition
WAVLM_MODEL=microsoft/wavlm-large
WHISPER_MODEL=large-v3-turbo
WHISPER_FALLBACK_MODEL=large-v3
SCORE_WORD_TIMESTAMPS=0
# ASR path: whisper runs on CPU; "off" = fastest scoring (no transcript / WER gate); "fast"/"words" enable alignment.
SCORE_ASR_MODE=off
SCORE_INCLUDE_FORMANTS=0    # 1 = better vowel-space detail, slower
SCORE_WAVLM_MODE=auto       # auto | off
SCORE_RESPONSE_CACHE=1
SCORE_RESPONSE_CACHE_SIZE=256
SCORE_TRANSCRIPT_CACHE_SIZE=256
SCORE_EMBEDDING_CACHE_SIZE=256
NATIVE_F0_DISK_CACHE=1
NATIVE_F0_CACHE_DIR=cache/native_f0
VOICE_TARGET_ACCENT_ORDER=vc,instruct
VOICE_NATURAL_ORDER=zero_shot,instruct,vc
PREWARM_MODELS=1
PREWARM_ACCENTS=GA,RP
PREWARM_PHRASES=Ship or sheep?|This is a thin thing.|The right light is bright.|Three free throws.
FORCE_WAVLM_ENGINE=0
PRELOAD_ACCENT_CONVERTER=0
PHONEME_SCORER_CHECKPOINT=checkpoints/phoneme_scorer_best.pt
ASSESSMENT_SCORER_CHECKPOINT=checkpoints/assessment_head_best.pt

# Accent reference centroids (computed during setup)
ACCENT_CENTROIDS_PATH=checkpoints/accent_centroids.pt
