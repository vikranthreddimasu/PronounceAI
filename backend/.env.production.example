# Container/runtime defaults for the FastAPI backend.
# These values are intended for reproducible local Docker runs from a clean
# checkout. They avoid private model paths and keep the heaviest optional
# systems disabled by default.

PORT=8000
DEVICE=cpu
LOG_LEVEL=info

# Set this to the frontend origin that will call the API.
# Local compose example: CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=

# Public Hugging Face models do not require a token, but a token can help with
# rate limits or private model access.
HUGGINGFACE_TOKEN=

# Public model IDs keep Docker reproducible without untracked local model dirs.
WAV2VEC2_MODEL=slplab/wav2vec2-large-robust-L2-english-phoneme-recognition
WAVLM_MODEL=microsoft/wavlm-large
WHISPER_MODEL=small.en
WHISPER_FALLBACK_MODEL=small.en
KOKORO_REPO_ID=hexgrad/Kokoro-82M
KOKORO_CONFIG=
KOKORO_MODEL=
KOKORO_DEVICE=cpu
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
NLTK_DATA=/usr/local/share/nltk_data

# Conservative CPU defaults. Set LOAD_WHISPER=1 and SCORE_ASR_MODE=fast
# when you want transcript/WER grounding and can tolerate the extra download.
LOAD_WHISPER=0
LOAD_VOICE_CLONE=0
PREWARM_MODELS=0
SCORE_ASR_MODE=off
SCORE_INCLUDE_FORMANTS=0
SCORE_WAVLM_MODE=off
FORCE_WAVLM_ENGINE=0
PRELOAD_ACCENT_CONVERTER=0

# Runtime paths inside the container.
ENROLLMENT_DIR=/app/data/enrollments
NATIVE_F0_CACHE_DIR=/app/cache/native_f0
PHONEME_SCORER_CHECKPOINT=checkpoints/phoneme_scorer_best.pt
ASSESSMENT_SCORER_CHECKPOINT=checkpoints/assessment_head_best.pt
ACCENT_CENTROIDS_PATH=checkpoints/accent_centroids.pt
ESPEAK_NG_LIB=/usr/lib/x86_64-linux-gnu/libespeak-ng.so.1
